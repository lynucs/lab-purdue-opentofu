http_port {{ squid_port }} ssl-bump \
  cert={{ squid_ssl_dir }}/squid_bump.pem \
  generate-host-certificates=on \
  dynamic_cert_mem_cache_size={{ squid_dynamic_cert_mem_cache_size }}

sslcrtd_program {{ squid_security_file_certgen_bin }} -s {{ squid_ssl_db_path }} -M {{ squid_ssl_db_size_mb }}MB
sslcrtd_children 5

{% for net in squid_allowed_nets %}
acl localnet src {{ net }}
{% endfor %}

acl whitelist dstdomain "/etc/squid/whitelist.txt"

acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl Safe_ports port 21
acl Safe_ports port 1025-65535
acl CONNECT method CONNECT

acl step1 at_step SslBump1

ssl_bump peek step1
ssl_bump bump whitelist
ssl_bump terminate all

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localhost
http_access allow localnet whitelist
http_access deny all

cache_dir ufs /var/spool/squid {{ squid_cache_size_mb }} 16 256
coredump_dir /var/spool/squid

access_log daemon:/var/log/squid/access.log squid
cache_log /var/log/squid/cache.log

shutdown_lifetime 2 seconds