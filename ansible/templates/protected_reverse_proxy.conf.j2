server {
    listen {{ waf_listen_ip }}:{{ nginx_http_port }};
    listen {{ waf_listen_ip }}:{{ nginx_https_port }} ssl;
    server_name _;

    ssl_certificate     /etc/nginx/modsec/nginx.crt;
    ssl_certificate_key /etc/nginx/modsec/nginx.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    modsecurity on;
    modsecurity_rules_file /etc/nginx/modsec/main.conf;

{% for backend in protected_backends %}
    location = /{{ backend.name }} {
        return 301 $scheme://$http_host/{{ backend.name }}/;
    }

    location /{{ backend.name }}/ {
        proxy_pass {{ backend.url }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /{{ backend.name }};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_ssl_verify off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
{% endfor %}

    location / {
        return 404;
    }
}