# 1. VIOLATION DE CLOISONNEMENT L4/L5 DIRECT VERS OT (BYPASS IDMZ - NIVEAU 3.5)
# ------------------------------------------------------------------------------
# Tout flux direct de la zone IT vers la zone OT sans rebond applicatif iDMZ
alert ip {{ purdue_net_it }} any -> {{ purdue_net_ot }} any (msg:"PURDUE L4->L3 VIOLATION - Acces direct IT vers OT detecte (Bypass iDMZ)"; classtype:policy-violation; priority:1; sid:9910001; rev:1;)

# Flux sortant direct initie depuis le reseau OT vers l'IT ou l'exterieur
